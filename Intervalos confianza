server <- function(input, output, session) {
  # Un estado por sesión; mismo diseño y semilla reproducen las mismas muestras.
  samples <- reactive({
    req(is.finite(input$mu), is.finite(input$sigma), is.finite(input$seed))
    validate(need(input$mu>0 && input$mu<=100, "μ debe estar entre 0 y 100."),
             need(input$sigma>0 && input$sigma<=50, "σ debe estar entre 0 y 50."),
             need(input$seed>=1 && input$seed<=2147483000 && input$seed==floor(input$seed),
                  "Introduce una semilla entera válida."))
    B <- as.integer(input$B); n <- as.integer(input$n)
    set.seed(as.integer((as.double(input$seed) + input$new) %% 2147483647))
    x <- switch(input$pop,
      normal=rnorm(n*B,input$mu,input$sigma), exp=rexp(n*B,rate=1/input$mu),
      uniform=runif(n*B,0,2*input$mu), bern=rbinom(n*B,1,input$p))
    x <- matrix(x,nrow=n,ncol=B)
    theta <- if(input$pop=="bern") input$p else input$mu
    sigma <- switch(input$pop,normal=input$sigma,exp=input$mu,
                    uniform=input$mu/sqrt(3),bern=sqrt(input$p*(1-input$p)))
    list(x=x, estimate=colMeans(x), s=apply(x,2,sd), theta=theta,
         sigma=sigma, n=n, B=B, pop=input$pop,
         seed=(as.double(input$seed)+input$new) %% 2147483647)
  })
  observeEvent(input$B, {
    updateSliderInput(session,"sample",max=as.integer(input$B),value=1)
  })
  intervals <- reactive({
    a <- samples(); est <- a$estimate
    z <- qnorm(1-(1-input$level/100)/2)
    if(a$pop=="bern") {
      if(input$prop_method=="wilson") {
        den <- 1+z^2/a$n
        center <- (est+z^2/(2*a$n))/den
        half <- z*sqrt(est*(1-est)/a$n+z^2/(4*a$n^2))/den
      } else {
        center <- est; half <- z*sqrt(est*(1-est)/a$n)
      }
    } else {
      center <- est
      half <- if(input$mean_method=="t") qt(1-(1-input$level/100)/2,a$n-1)*a$s/sqrt(a$n) else z*a$sigma/sqrt(a$n)
    }
    lo <- center-half; hi <- center+half
    data.frame(muestra=seq_len(a$B),estimacion=est,inferior=lo,superior=hi,
               contiene=(lo<=a$theta & hi>=a$theta))
  })
  index <- reactive(min(input$sample,samples()$B))
  # La inferencia chi-cuadrado para σ² exige normalidad; S² se muestra para todas las poblaciones.
  variance_results <- reactive({
    a <- samples(); s2 <- a$s^2; alpha <- 1-input$level/100
    lo <- hi <- rep(NA_real_,a$B)
    if(a$pop=="normal") {
      lo <- (a$n-1)*s2/qchisq(1-alpha/2,df=a$n-1)
      hi <- (a$n-1)*s2/qchisq(alpha/2,df=a$n-1)
    }
    data.frame(muestra=seq_len(a$B),s2=s2,inferior=lo,superior=hi,
               contiene=(lo<=a$sigma^2 & hi>=a$sigma^2))
  })
  output$variance_assumptions <- renderUI({
    if(samples()$pop=="normal")
      div(class="nota","Población normal: se muestran el intervalo exacto basado en chi-cuadrado y su cobertura.")
    else div(class="nota","Para esta población se muestra S² y su distribución empírica. El intervalo chi-cuadrado no es válido en general fuera del modelo normal; selecciona Normal para explorar sus intervalos y cobertura.")
  })
  output$variance_one <- renderUI({
    a <- samples(); d <- variance_results()[index(),]
    div(class="metricas",
      strong(sprintf("Muestra %d · S² = %.4f · σ² real = %.4f",index(),d$s2,a$sigma^2)),
      p(sprintf("Error observado S² − σ² = %+.4f",d$s2-a$sigma^2)),
      if(a$pop=="normal") p(sprintf("IC del %d %% para σ²: [%.4f, %.4f]. %s",input$level,d$inferior,d$superior,
        if(d$contiene) "Contiene la varianza real." else "No contiene la varianza real.")))
  })
  output$variance_sampling <- renderPlot({
    a <- samples(); d <- variance_results(); v <- a$sigma^2
    par(mar=c(4,4,2,1))
    h <- hist(d$s2,breaks=35,plot=FALSE)
    # La densidad escalada puede ser infinita en cero con n=2: dibujar desde un valor positivo.
    grid <- seq(max(.Machine$double.eps,v*1e-6),
                max(c(d$s2,v))*1.05,length.out=800)
    dens <- if(a$pop=="normal") dchisq((a$n-1)*grid/v,df=a$n-1)*(a$n-1)/v else NULL
    plot(h,freq=FALSE,col="#a9c9d6",border="white",xlim=c(0,max(c(d$s2,v))*1.05),
         ylim=c(0,max(h$density)*1.2),xlab="Varianza muestral S²",ylab="Densidad",
         main=paste(a$B,"varianzas muestrales"))
    if(a$pop=="normal") lines(grid,dens,col="#b65e18",lwd=2)
    abline(v=v,col="#263238",lty=2,lwd=2)
    abline(v=d$s2[index()],col="#176a87",lwd=2)
    legend("topright",c("Varianza poblacional σ²","S² seleccionada",if(a$pop=="normal") "Densidad teórica exacta"),
           col=c("#263238","#176a87",if(a$pop=="normal") "#b65e18"),
           lty=c(2,1,if(a$pop=="normal") 1),bty="n",cex=.85)
  })
  output$variance_summary <- renderUI({
    a <- samples(); s2 <- variance_results()$s2
    div(class="metricas",
      sprintf("Media de S²: %.4f · sesgo empírico: %+.4f · desviación empírica de S²: %.4f",mean(s2),mean(s2)-a$sigma^2,sd(s2)),
      if(a$pop=="normal") p(sprintf("Error estándar teórico de S²: σ² √[2/(n−1)] = %.4f",a$sigma^2*sqrt(2/(a$n-1)))),
      p("S² es insesgado para las cuatro poblaciones incluidas. La referencia chi-cuadrado y la fórmula del error estándar anterior se aplican a la población normal."))
  })
  output$variance_intervals <- renderPlot({
    a <- samples()
    validate(need(a$pop=="normal","Selecciona una población normal para ver los intervalos chi-cuadrado."))
    d <- head(variance_results(),input$shown)
    co <- ifelse(d$contiene,"#176a87","#c34825")
    par(mar=c(4,4,2,1))
    plot(d$s2,d$muestra,type="n",xlim=range(c(d$inferior,d$superior,a$sigma^2)),
         ylim=rev(range(d$muestra)),xlab="S² e intervalo de confianza para σ²",
         ylab="Número de muestra",main=paste("Primeros",nrow(d),"intervalos para la varianza"))
    abline(v=a$sigma^2,col="#263238",lty=2,lwd=2)
    segments(d$inferior,d$muestra,d$superior,d$muestra,col=co,lwd=2)
    points(d$s2,d$muestra,col=co,pch=16,cex=.65)
    legend("topright",c("Contiene σ²","No contiene σ²"),col=c("#176a87","#c34825"),lty=1,bty="n",cex=.8)
  })
  output$variance_coverage <- renderUI({
    a <- samples()
    if(a$pop!="normal") return(NULL)
    d <- variance_results(); cov <- mean(d$contiene)
    div(class="metricas",
      strong(sprintf("Cobertura de σ²: %.2f %% (%d de %d).",100*cov,sum(d$contiene),a$B)),
      p(sprintf("Nivel nominal: %d %% · anchura media: %.4f · error Monte Carlo aproximado: %.2f puntos porcentuales.",input$level,mean(d$superior-d$inferior),100*sqrt(cov*(1-cov)/a$B))),
      p("El cálculo usa las B muestras. Se aplica la interpretación frecuentista y la cautela sobre el error Monte Carlo explicadas en la pestaña 3."))
  })
  method_name <- reactive(if(samples()$pop=="bern") input$prop_method else input$mean_method)
  output$context <- renderUI({
    a <- samples()
    div(class="nota", strong(sprintf("Parámetro real = %.3f",a$theta)),
        sprintf(" · n = %d · B = %d · confianza = %d %% · método: %s",a$n,a$B,input$level,method_name()))
  })
  output$one <- renderPlot({
    a <- samples(); i <- index(); x <- a$x[,i]
    par(mar=c(4,4,2,1))
    if(a$pop=="bern") {
      barplot(c(sum(x==0),sum(x==1)),names.arg=c("0 · fracaso","1 · éxito"),
              col=c("#a9c9d6","#176a87"),ylab="Frecuencia",main=paste("Muestra",i))
    } else {
      hist(x,breaks="FD",col="#a9c9d6",border="white",xlab="Observaciones individuales",
           main=paste("Muestra",i),xlim=range(c(x,a$theta,a$estimate[i])))
      abline(v=a$theta,col="#263238",lty=2,lwd=2)
      abline(v=a$estimate[i],col="#176a87",lwd=2)
      legend("topright",c("Parámetro real","Estimación"),col=c("#263238","#176a87"),lty=c(2,1),bty="n")
    }
  })
  output$one_text <- renderUI({
    a <- samples(); d <- intervals()[index(),]
    div(class="metricas",
      sprintf("Estimación: %.4f · error observado: %+.4f · IC: [%.4f, %.4f]. ",d$estimacion,d$estimacion-a$theta,d$inferior,d$superior),
      strong(if(d$contiene) "Contiene el parámetro." else "No contiene el parámetro."))
  })
  output$sampling <- renderPlot({
    a <- samples(); se <- a$sigma/sqrt(a$n)
    par(mar=c(4,4,2,1))
    lim <- range(c(a$estimate,a$theta+c(-4,4)*se))
    h <- hist(a$estimate,breaks=35,plot=FALSE)
    ymax <- max(h$density,if(input$theory) dnorm(a$theta,a$theta,se) else 0)*1.12
    plot(h,freq=FALSE,col="#a9c9d6",border="white",xlim=lim,ylim=c(0,ymax),
         main=paste(a$B,"estimaciones de muestras distintas"),xlab="Estimación",ylab="Densidad")
    abline(v=a$theta,col="#263238",lty=2,lwd=2)
    if(input$theory) curve(dnorm(x,a$theta,se),from=lim[1],to=lim[2],add=TRUE,col="#b65e18",lwd=2)
    abline(v=a$estimate[index()],col="#176a87",lwd=2)
    legend("topright",c("Parámetro real","Estimación seleccionada",if(input$theory) "Referencia normal"),
           col=c("#263238","#176a87",if(input$theory) "#b65e18"),lty=c(2,1,if(input$theory) 1),bty="n",cex=.85)
  })
  output$summary <- renderUI({
    a <- samples()
    div(class="metricas",sprintf("Media de estimaciones: %.4f · sesgo empírico: %+.4f · desviación empírica: %.4f · error estándar teórico: %.4f",mean(a$estimate),mean(a$estimate)-a$theta,sd(a$estimate),a$sigma/sqrt(a$n)),
        p("La desviación de las estimaciones describe la variabilidad entre muestras. Los estimadores incluidos son insesgados; el sesgo empírico puede ser distinto de cero por la simulación finita."))
  })
  output$intervals <- renderPlot({
    a <- samples(); d <- head(intervals(),input$shown)
    co <- ifelse(d$contiene,"#176a87","#c34825")
    par(mar=c(4,4,2,1))
    plot(d$estimacion,d$muestra,type="n",xlim=range(c(d$inferior,d$superior,a$theta)),
         ylim=rev(range(d$muestra)),xlab="Estimación e intervalo de confianza",
         ylab="Número de muestra",main=paste("Primeros",nrow(d),"intervalos"))
    abline(v=a$theta,col="#263238",lty=2,lwd=2)
    segments(d$inferior,d$muestra,d$superior,d$muestra,col=co,lwd=2)
    points(d$estimacion,d$muestra,col=co,pch=16,cex=.65)
    legend("topright",c("Contiene","No contiene"),col=c("#176a87","#c34825"),lty=1,bty="n",bg="white",cex=.8)
  })
  output$coverage <- renderUI({
    a <- samples(); d <- intervals(); cov <- mean(d$contiene)
    div(class="metricas",strong(sprintf("Cobertura observada: %.2f %% (%d de %d).",100*cov,sum(d$contiene),a$B)),
        p(sprintf("Nivel nominal: %d %% · anchura media: %.4f · error Monte Carlo aproximado: %.2f puntos porcentuales.",input$level,mean(d$superior-d$inferior),100*sqrt(cov*(1-cov)/a$B))),
        p("La cobertura usa las B muestras, aunque el gráfico solo muestre las primeras. No tiene por qué coincidir exactamente con el nivel nominal. El error Monte Carlo estimado puede ser cero si todos los resultados coinciden; esto no demuestra ausencia de incertidumbre."))
  })
  output$csv <- downloadHandler(
    filename=function() paste0("MT1012_",samples()$pop,"_simulacion.csv"),
    content=function(file) {
      a <- samples(); d <- intervals()
      d$parametro <- a$theta; d$n <- a$n; d$B <- a$B; d$poblacion <- a$pop
      d$semilla_efectiva <- a$seed; d$confianza <- input$level/100; d$metodo <- method_name()
      vd <- variance_results()
      d$varianza_muestral <- vd$s2; d$varianza_poblacional <- a$sigma^2
      d$varianza_ic_inferior <- vd$inferior; d$varianza_ic_superior <- vd$superior
      d$varianza_ic_contiene <- vd$contiene
      d$varianza_ic_metodo <- if(a$pop=="normal") "chi-cuadrado" else NA_character_
      write.csv(d,file,row.names=FALSE,fileEncoding="UTF-8")
    }
  )
}
shinyApp(ui,server)
